<% layout("/layouts/boilerplate") %>

<div class="row">
  <div class="col-8 offset-2">
    <h1>Create the new post</h1>

    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">

      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input
          id="title"
          type="text"
          placeholder="Enter the title"
          name="listing[title]"
          class="form-control"
          required
        >
        <div class="valid-feedback">Valid title</div>
        <div class="invalid-feedback">Invalid title</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea
          id="description"
          placeholder="Enter the description"
          name="listing[description]"
          class="form-control"
          required
        ></textarea>
        <div class="valid-feedback">Valid description</div>
        <div class="invalid-feedback">Invalid description</div>
      </div>

      <div class="row">
        <div class="mb-3 col-md-4">
          <label for="price" class="form-label">Price</label>
          <input
            id="price"
            type="number"
            placeholder="Enter the price"
            name="listing[price]"
            class="form-control"
            min="0"
            required
          >
          <div class="valid-feedback">Valid price</div>
          <div class="invalid-feedback">Enter a valid price</div>
        </div>

        <div class="mb-3 col-md-8">
          <label for="country" class="form-label">Country</label>
          <input
            id="country"
            type="text"
            placeholder="Enter the country"
            name="listing[country]"
            class="form-control"
            required
          >
          <div class="valid-feedback">Valid country</div>
          <div class="invalid-feedback">Invalid country</div>
        </div>
      </div>
       <div class="mb-3">
        <label for="image" class="form-label">Upload Image</label>
        <input
          id="image"
          type="file"
          placeholder="Enter the image URL"
          name="listing[image]"
          class="form-control" 
        >
        <div class="valid-feedback">Valid URL</div>
        <div class="invalid-feedback">Invalid URL</div>
      </div>

      <div class="mb-3">
        <label for="location" class="form-label">Location</label>
        <input
          id="location"
          type="text"
          placeholder="Enter the location"
          name="listing[location]"
          class="form-control"
          required
        >
        <div class="valid-feedback">Valid location</div>
        <div class="invalid-feedback">Invalid location</div>
      </div>

      <button class="btn btn-dark">Submit</button>
    </form>
  </div>
</div>