    <% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            
            <h3><%= listing.title %></h3>
        </div>
        <div class="card col-6 offset-3 listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top" alt="listings">
            <div class="card-body">
    <!-- <h5 class="card-title"></h5> -->
    <p class="card-text"> <%= listing.owner.username %> <br><%= listing.description %> <br> &#8377;<%= listing.price.toLocaleString("en-IN")%> /per night
        <br>
        <%=listing.location %> <br>
        <%= listing.country %> <br>

    </p>
    <!-- <a href="#" class="btn btn-primary">Go somewhere</a> -->
  </div>
        </div>
    <!-- <h1>Listing Deatils:</h1> -->
    
        <!-- <a href="<%= listing._id %>/edit">Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button>Delete Button</button>
        </form> -->
    
    </div>
    <div class="btns mb-5">
       <!-- <% if(curruser && curruser._id.equals(listing.owner._id)){ %> -->
          <a href="<%= listing._id %>/edit" class="btn btn-dark col-1 offset-4 edit-btn">Edit</a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button class="btn btn-dark offset-7">Delete</button>
        </form>
        <!-- <% } %> -->
        
    </div>
    <div class="col-8 offset-3">
        <% if(curruser) { %>
        <h4>Give Reveiw</h4>
        <form action="/listings/<%= listing.id %>/reviews" method="post" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                 <label for="rating">Rating</label>
            <fieldset class="starability-slot">
 
  <input type="radio" id="no-rate" class="input-no-rate"   name="review[rating]"  value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1"   name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2"   name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3"   name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4"   name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset></div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comment</label>
                <textarea id="comment" name="review[comment]" cols="30" rows="10" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add the your opinion</div>
            </div>
            <button class="btn btn-outline-dark">Add Review</button>
        </form>
        <% } %>
        <h4>All Reviews</h4>
       
        <div class="row">
        <% for(review of listing.reviews){ %>
            <div class="card col-5 ms-3 mb-3">
                <div class="card-body">
                    <div class="card-title"><%= review.author.username %></div>
                    <p class="starability-result card-text" data-rating="<%= review.rating %>">
    Rated: <%= review.rating %>stars
  </p>
                    <div class="card-text"><%= review.comment %></div>
                    <div class="card-text"><%= review.rating %> Star</div>
                    
                    <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=delete" method="post">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            </div>
            <% } %>
    </div>

   
    <!-- <br>
 </body> 
